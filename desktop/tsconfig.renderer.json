{
  "compilerOptions": {
    "target": "ES2020",
    "module": "esnext",
    "rootDir": "src/renderer",
    "outDir": "dist/renderer",
    "strict": true,
    "lib": ["ES2020", "DOM"],
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "sourceMap": false
  },
  "include": ["src/renderer/**/*.ts"]
}
